{
  "name": "studio-fantome",
  "version": "0.1.0",
  "private": true,
  "description": "Média francophone automatisé sur l'écosystème Claude, présenté par un fantôme robot 3D (TikTok + YouTube Shorts).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "fm": "tsx src/cli.ts",
    "studio": "remotion studio video/index.ts --public-dir video/public",
    "typecheck": "tsc --noEmit",
    "matcaps": "tsx scripts/bake-matcaps.ts",
    "bible": "tsx scripts/bible.ts",
    "textures": "tsx scripts/gen-textures.ts",
    "test": "tsx --test src/core/core.test.ts src/voice/voice.test.ts src/lib/secrets.test.ts src/lib/jetons.test.ts src/publish/instagram.test.ts src/lib/acces.test.ts src/publish/tiktok.test.ts",
    "identite": "tsx scripts/identite.ts"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "@remotion/bundler": "^4.0.543",
    "@remotion/captions": "^4.0.543",
    "@remotion/cli": "^4.0.543",
    "@remotion/fonts": "^4.0.543",
    "@remotion/layout-utils": "^4.0.543",
    "@remotion/media": "^4.0.543",
    "@remotion/media-utils": "^4.0.543",
    "@remotion/renderer": "^4.0.543",
    "@remotion/three": "^4.0.543",
    "@remotion/transitions": "^4.0.543",
    "lucide-react": "^1.72.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "^4.0.543",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
