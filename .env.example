# Copier en .env pour un usage local (ne jamais committer .env). En production : secrets GitHub Actions.

# --- Cerveau (Claude Code en mode non interactif) : l'un OU l'autre
CLAUDE_CODE_OAUTH_TOKEN=        # `claude setup-token` (abonnement Claude Pro/Max)
ANTHROPIC_API_KEY=              # ou une clé API (facturation à l'usage)

# --- Voix (ElevenLabs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=            # identifiant de la voix choisie (Voice Library)

# --- YouTube (Google Cloud > OAuth « Application de bureau »)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=          # obtenu avec `npm run fm -- auth youtube`

# --- TikTok (TikTok for Developers)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=            # ex. https://<compte>.github.io/<depot>/tiktok-callback.html
TIKTOK_REFRESH_TOKEN=           # obtenu avec `npm run fm -- auth tiktok`
FM_CLE_JETONS=                  # phrase secrète longue : chiffre les jetons TikTok renouvelés

# --- Divers
GITHUB_TOKEN=                   # lecture de l'API GitHub pour la veille (fourni automatiquement en CI)
REMOTION_BROWSER_EXECUTABLE=    # optionnel : navigateur headless imposé
